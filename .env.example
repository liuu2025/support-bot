# ---------------------------------------------------------------------------
# 公开环境变量模板。推荐复制 private/support-bot.env.example，真实配置只保存在 private/ 下。
# ---------------------------------------------------------------------------

# "dev"（默认）或 "prod"。prod 要求真实 JWT 校验、Postgres 与 Redis。
ENV=dev

# 鉴权："dev" 开放 POST /api/dev/token，方便本地切换身份；"jwt" 用你站点签发的 token；
# "demo" 是公开沙箱（访客自动获得一次性客户身份）。
AUTH_MODE=dev
JWT_SECRET=             # 本地随机生成的 HS256 共享密钥（≥32 字节）
# JWT_JWKS_URL=          # 你的 IdP 的 JWKS 地址（RS256/ES256）
# JWT_ISSUER=
# JWT_AUDIENCE=

# --- 模型服务（OpenAI 兼容）--------------------------------------------------
# 推荐做法：什么都不填，启动后到网页「模型设置」里配置（地址 + 密钥 + 选模型），
# 支持官方接口与中转站，保存后立即生效，无需重启。
# 下面三个变量只作为"首次启动的默认值"，也是命令行跑评测时要用的：
# MODEL_BASE_URL=https://api.deepseek.com/v1
# MODEL_API_KEY=replace-with-local-key
# MODEL_NAME=deepseek-chat
# 评测用的判分模型，默认与 MODEL_NAME 相同：
# EVAL_JUDGE_MODEL=deepseek-chat

# 存储密钥用的主密钥（Fernet 加密保存在数据库里的 API Key）。
# 本地 Compose 也必须设置；请使用随机生成的值。
CONFIG_SECRET_KEY=

# Docker Compose 的数据库凭据。请使用随机密码，不要沿用示例值。
POSTGRES_USER=support_bot
POSTGRES_PASSWORD=
POSTGRES_DB=support_bot
DATABASE_URL=postgresql://support_bot:replace-with-url-encoded-password@postgres:5432/support_bot

# 存储。Compose 会根据上面的变量连接 Postgres；直接跑 uvicorn 时可以使用：
# REDIS_URL=redis://localhost:6379/0
# SEED_ON_STARTUP=true

# --- 护栏（见 README 的「限制与护栏」）。全部可选，下面是默认值。---
# MAX_MESSAGE_CHARS=2000
# MAX_CONVERSATION_TURNS=30
# MAX_CONVERSATION_TOKENS=60000
# CUSTOMER_DAILY_TOKEN_BUDGET=300000
# AGENT_RECURSION_LIMIT=12
# MAX_OUTPUT_TOKENS=1024
# CHAT_RATE_LIMIT=10/minute          # 每个客户
# MAX_CONCURRENT_TURNS=200           # 全局并发上限（超出返回 503）
# TURN_TIMEOUT_S=120

# --- Opik 链路追踪与成本看板（可选）---
# OPIK_URL_OVERRIDE=http://host.docker.internal:5173/api
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=support-bot

# --- 公开演示（AUTH_MODE=demo）---
# DEMO_SESSION_RATE_LIMIT=5/hour     # 每个 IP 新建沙箱的次数
# DEMO_TOKEN_TTL_S=7200
# DEMO_DATA_TTL_HOURS=24             # 到期由清理任务删除
# DEMO_GLOBAL_DAILY_TOKEN_BUDGET=0   # 0 = 不限；用完后新的对话会被拒绝
# TURNSTILE_SECRET=                  # 可选：Cloudflare Turnstile 机器人校验
# TRUSTED_PROXY_HOPS=0               # 前面有几层代理追加 X-Forwarded-For

# --- 前端构建（Vite）---
# VITE_API_BASE_URL=                 # 前后端分开部署时的后端地址
