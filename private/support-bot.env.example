# Copy to private/support-bot.env and fill every value locally.
ENV=dev
AUTH_MODE=dev
JWT_SECRET=replace-with-at-least-32-random-bytes
CONFIG_SECRET_KEY=replace-with-a-random-fernet-key
POSTGRES_USER=support_bot
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=support_bot
DATABASE_URL=postgresql://support_bot:replace-with-url-encoded-password@postgres:5432/support_bot
LOG_LEVEL=INFO
LOG_JSON=true
